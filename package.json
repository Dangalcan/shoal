{
  "name": "kubernetes-desktop",
  "version": "1.0.0",
  "description": "",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "npm run dev",
    "build:plugin-runtime": "esbuild src/features/plugins/sandbox/frame-runtime.tsx --bundle --format=iife --outfile=public/plugin-host/bootstrap.js --jsx=automatic --minify",
    "predev": "npm run build:plugin-runtime",
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\" \"npm run dev:backend\"",
    "dev:react": "vite",
    "dev:electron": "npm run build:electron && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 ALLOW_UNSIGNED_PLUGINS=true electron .",
    "dev:backend": "cd marketplace-backend && npm run dev",
    "build:electron": "tsc -p electron/tsconfig.json",
    "prebuild:react": "npm run build:plugin-runtime",
    "build:react": "tsc && vite build",
    "build": "npm run build:react && npm run build:electron && electron-builder",
    "build:win": "npm run build:react && npm run build:electron && electron-builder --win",
    "build:linux": "npm run build:react && npm run build:electron && electron-builder --linux",
    "test": "vitest --run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "npm run build:react && npm run build:electron && playwright test",
    "test:e2e:interactive": "npm run build:react && npm run build:electron && playwright test e2e/explore.spec.ts --headed --debug",
    "test:e2e:report": "playwright show-report e2e-report",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:eslint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:prettier": "prettier --check '**/*.{cjs,js,ts,css,scss,md}'",
    "lint:fix": "npm run lint:eslint -- --fix && prettier --write '**/*.{cjs,js,ts,css,scss,md}'",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dangalcan/Kubernetes-Desktop.git"
  },
  "lint-staged": {
    "*.{js,ts,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "LGPL-3.0-or-later",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Dangalcan/Kubernetes-Desktop/issues"
  },
  "homepage": "https://github.com/Dangalcan/Kubernetes-Desktop#readme",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.6.2",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.562.0",
    "node-machine-id": "^1.1.12",
    "prettier": "^3.7.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.11.0",
    "semver": "^7.7.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.1.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "sass": "^1.98.0",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.dangalcan.kubernetes-desktop",
    "productName": "Kubernetes Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "publish": null
    },
    "linux": {
      "icon": "public/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
