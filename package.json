{
  "name": "shoal",
  "version": "0.9.0-rc.6",
  "description": "Desktop app for managing Kubernetes clusters.",
  "desktopName": "shoal.desktop",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "npm run dev",
    "build:plugin-runtime": "esbuild src/features/plugins/sandbox/frame-runtime.tsx --bundle --format=iife --outfile=public/plugin-host/bootstrap.js --jsx=automatic --minify",
    "dev": "npm run build:plugin-runtime && concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:full": "npm run build:plugin-runtime && concurrently \"npm run dev:react\" \"npm run dev:electron\" \"npm run dev:backend\"",
    "dev:react": "vite",
    "dev:electron": "npm run build:electron && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 ALLOW_UNSIGNED_PLUGINS=true MARKETPLACE_ENABLED=true MARKETPLACE_BACKEND_URL=http://localhost:3001/v1 electron .",
    "dev:backend": "cd ../kdMarket && npm run dev",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:react": "npm run build:plugin-runtime && tsc && vite build",
    "build": "npm run build:react && npm run build:electron && electron-builder",
    "build:win": "npm run build:react && npm run build:electron && electron-builder --win",
    "build:linux": "npm run build:react && npm run build:electron && electron-builder --linux",
    "test": "vitest --run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --run --coverage",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test:e2e": "npm run build:react && npm run build:electron && playwright test",
    "test:e2e:interactive": "npm run build:react && npm run build:electron && playwright test -c e2e/explore.config.ts --debug",
    "test:e2e:report": "playwright show-report e2e-report",
    "screenshots": "playwright test -c e2e/screenshots.config.ts",
    "demo-gif": "playwright test -c e2e/demo.config.ts && node scripts/demo-gif.js",
    "lint": "npm run lint:eslint && npm run lint:prettier",
    "lint:eslint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:prettier": "prettier --check \"**/*.{cjs,js,ts,tsx,json,css,scss,md}\"",
    "lint:fix": "npm run lint:eslint -- --fix && prettier --write \"**/*.{cjs,js,ts,tsx,json,css,scss,md}\"",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dangalcan/shoal.git"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "cross-env ESLINT_USE_FLAT_CONFIG=false eslint"
    ],
    "*.{cjs,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "kubernetes",
    "k8s",
    "kubectl",
    "kind",
    "k3d",
    "helm",
    "kompose",
    "electron",
    "desktop",
    "devops",
    "developer-tools"
  ],
  "author": {
    "name": "Daniel Galván Cancio",
    "email": "92941017+Dangalcan@users.noreply.github.com"
  },
  "license": "LGPL-3.0-or-later",
  "engines": {
    "node": ">=22.12"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Dangalcan/shoal/issues"
  },
  "homepage": "https://github.com/Dangalcan/shoal#readme",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "js-yaml": "^5.5.0",
    "node-machine-id": "^1.1.12",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lucide-react": "^1.61.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sass": "^1.106.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.dangalcan.shoal",
    "productName": "Shoal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/__tests__/**",
      "package.json",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3/prebuilds/{darwin-*,linuxmusl-*,linux-arm64,win32-arm64}.node"
    ],
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "beforePack": "scripts/third-party-notices.js",
    "extraResources": [
      {
        "from": "COPYING.LESSER",
        "to": "LICENSE.txt"
      },
      {
        "from": "COPYING",
        "to": "COPYING.txt"
      },
      {
        "from": "NOTICE",
        "to": "COPYRIGHT.txt"
      },
      {
        "from": "build/THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "plugins/namespace-watcher",
        "to": "plugins/namespace-watcher",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "plugins/resource-monitor",
        "to": "plugins/resource-monitor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Dangalcan",
        "repo": "shoal"
      }
    ],
    "win": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "public/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "desktop": {
        "entry": {
          "Comment": "Desktop app for your Kubernetes clusters",
          "Keywords": "kubernetes;k8s;kubectl;kind;k3d;cluster;devops;"
        }
      }
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
