{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["@typescript-eslint", "react", "react-hooks"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      { "argsIgnorePattern": "^_" }
    ],
    "@typescript-eslint/no-empty-object-type": [
      "error",
      { "allowInterfaces": "with-single-extends" }
    ],
    "react-hooks/set-state-in-effect": "warn",
    "complexity": ["warn", 15],
    "max-lines-per-function": ["warn", 100],
    "max-lines": ["warn", 500]
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "overrides": [
    {
      "files": ["scripts/**/*.js"],
      "parserOptions": { "sourceType": "script" },
      "rules": {
        "@typescript-eslint/no-require-imports": "off"
      }
    },
    {
      "files": ["src/test/**", "electron/__tests__/**", "e2e/**"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off"
      }
    },
    {
      "files": ["e2e/**"],
      "rules": {
        "react-hooks/rules-of-hooks": "off",
        "no-empty-pattern": "off"
      }
    },
    {
      "files": ["electron/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react/*",
                  "react-dom",
                  "react-dom/*",
                  "react-router-dom",
                  "lucide-react",
                  "sonner",
                  "clsx",
                  "tailwind-merge",
                  "@xterm/*"
                ],
                "message": "Renderer-only library: a devDependency that Vite bundles into dist/, so it is not packaged for the main process (see BUNDLED_RENDERER_PACKAGES in scripts/third-party-notices.js)."
              }
            ]
          }
        ]
      }
    }
  ]
}
