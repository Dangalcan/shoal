pkgbase = shoal-bin
	pkgdesc = Desktop app for managing Kubernetes clusters
	pkgver = 0.9.1
	pkgrel = 1
	url = https://shoal.dangalcan.com
	arch = x86_64
	license = LGPL-3.0-or-later
	depends = gtk3
	depends = libnotify
	depends = nss
	depends = libxss
	depends = libxtst
