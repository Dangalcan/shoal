{
  "id": "resource-monitor",
  "name": "Resource Monitor",
  "version": "1.1.1",
  "description": "Monitors Pod resources within namespaces. Depends on Namespace Watcher.",
  "author": "Shoal Team",
  "main": "index.js",
  "renderer": "renderer.js",
  "styles": ["styles.css"],
  "permissions": ["kubernetes", "ui", "storage", "notifications"],
  "category": "Monitoring",
  "license": {
    "type": "free",
    "spdx": "MIT"
  },
  "dependencies": {
    "namespace-watcher": ">=1.0.0"
  },
  "configuration": {
    "title": "Monitor Settings",
    "properties": {
      "refreshRate": {
        "type": "number",
        "label": "Refresh Rate (ms)",
        "default": 10000,
        "min": 1000
      },
      "alertThreshold": {
        "type": "number",
        "label": "CPU Alert Threshold (%)",
        "default": 80,
        "min": 1,
        "max": 100
      },
      "notifyOnAlert": {
        "type": "boolean",
        "label": "Show Desktop Notification on Alert",
        "default": true
      },
      "excludedNamespaces": {
        "type": "array",
        "label": "Excluded Namespaces",
        "default": ["kube-system", "kube-public"]
      },
      "restartThreshold": {
        "type": "number",
        "label": "Restart Alert Threshold (per scan)",
        "description": "Alert when a pod's restart count increases by this many since the last scan.",
        "default": 3,
        "min": 1
      }
    }
  },
  "extensions": {
    "widgets": [
      {
        "id": "pod-monitor-widget",
        "title": "Live Pulse",
        "size": "small"
      }
    ],
    "resourceActions": [
      {
        "id": "rm-inspect",
        "label": "Inspect Pod",
        "icon": "Search",
        "resourceTypes": ["pods"]
      }
    ]
  }
}
